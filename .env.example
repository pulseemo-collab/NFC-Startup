# ---------------------------------------------------------------------------
# NFC Reseller — environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the real values.
#   cp .env.example .env.local
# `.env.local` is gitignored and must NEVER be committed.
#
# Where to find these values: Supabase Dashboard -> Project Settings -> API.
# Full walkthrough: docs/SUPABASE_SETUP.md
# ---------------------------------------------------------------------------

# PUBLIC — safe to expose to the browser (shipped in the client bundle).
# Supabase -> Project Settings -> API -> "Project URL".
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# PUBLIC — the anon/public key. Safe to expose; it is gated by Row Level Security.
# Supabase -> Project Settings -> API -> "Project API keys" -> "anon" "public".
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET — the service role key. FULL database access; bypasses Row Level Security.
# Used ONLY on the server (dashboard reads/writes). NEVER prefix it with
# NEXT_PUBLIC_ and NEVER import it into a client component.
# Supabase -> Project Settings -> API -> "Project API keys" -> "service_role".
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
